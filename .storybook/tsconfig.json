{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": [
			"node"
		],
		"allowSyntheticDefaultImports": true,
	},
	"include": [
		"**/*.stories.ts",
		"../src/**/*",
		"../projects/**/*"
	],
	"exclude": [
		"../src/test.ts",
		"../src/**/*.spec.ts",
		"../src/**/*-exported-tests.ts",
		"../src/exported-tests/**",
		"../src/test-helpers/**"
	],
}
